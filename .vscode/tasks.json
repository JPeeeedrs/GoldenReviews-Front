{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Backend (Flask)",
			"type": "shell",
			"command": "c:/Desktop/goldenReviews/.venv/Scripts/python.exe",
			"args": [
				"backend/app.py"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run Frontend (Vite)",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run Backend (FastAPI)",
			"type": "shell",
			"command": "c:/Desktop/goldenReviews/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"uvicorn",
				"backend.app:app",
				"--reload",
				"--host",
				"0.0.0.0",
				"--port",
				"8000"
			],
			"isBackground": true,
			"group": "build"
		}
	]
}